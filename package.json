{
    "name": "@axisparkjs/benchmarks",
    "version": "0.0.0",
    "private": true,
    "description": "Reproducible performance reports of every AxiSpark.js release",
    "license": "Apache-2.0",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "set-version": "node scripts/set-version.mjs",
        "bench": "npm run build && node --expose-gc dist/runner/run.js",
        "bench:micro": "npm run bench -- --tier micro",
        "bench:app": "npm run bench -- --tier app",
        "bench:infra": "npm run bench -- --tier infra",
        "coverage": "npm run build && node dist/runner/coverage.js",
        "index": "npm run build && node dist/runner/results-index.js",
        "infra:up": "docker compose up -d --wait",
        "infra:down": "docker compose down -v"
    },
    "engines": {
        "node": ">= 24"
    },
    "dependencies": {
        "@axisparkjs/cli": "1.5.1",
        "@axisparkjs/common": "1.5.1",
        "@axisparkjs/core": "1.5.1",
        "@axisparkjs/data": "1.5.1",
        "@axisparkjs/ddd": "1.5.1",
        "@axisparkjs/di": "1.5.1",
        "@axisparkjs/engine": "1.5.1",
        "@axisparkjs/http": "1.5.1",
        "@axisparkjs/http-express": "1.5.1",
        "@axisparkjs/http-fastify": "1.5.1",
        "@axisparkjs/kafka": "1.5.1",
        "@axisparkjs/logger": "1.5.1",
        "@axisparkjs/mcp": "1.5.1",
        "@axisparkjs/openapi": "1.5.1",
        "@axisparkjs/rabbitmq": "1.5.1",
        "@axisparkjs/redis": "1.5.1",
        "@axisparkjs/schedule": "1.5.1",
        "@axisparkjs/security": "1.5.1",
        "@axisparkjs/store": "1.5.1",
        "@axisparkjs/test": "1.5.1",
        "@axisparkjs/websocket": "1.5.1",
        "@axisparkjs/websocket-socketio": "1.5.1",
        "@fastify/multipart": "10.1.8",
        "@modelcontextprotocol/client": "2.4.0",
        "@modelcontextprotocol/server": "2.4.0",
        "amqp-connection-manager": "5.0.1",
        "amqplib": "2.2.1",
        "busboy": "1.6.0",
        "class-validator": "0.15.1",
        "cron": "4.4.0",
        "express": "5.3.0",
        "fastify": "5.12.8",
        "kafkajs": "2.2.4",
        "mongodb": "7.8.0",
        "mysql2": "3.24.6",
        "pg": "8.23.1",
        "redis": "6.3.1",
        "reflect-metadata": "0.2.2",
        "socket.io": "4.8.4",
        "socket.io-client": "4.8.4",
        "tinybench": "6.2.3",
        "typeorm": "1.1.2"
    },
    "devDependencies": {
        "@types/amqplib": "0.10.7",
        "@types/busboy": "1.5.4",
        "@types/express": "5.0.6",
        "@types/node": "26.6.6",
        "typescript": "6.0.3"
    }
}
